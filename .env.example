# GEMINI_API_KEY: Optional if AI features are enabled
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL of the CyberWave dashboard
APP_URL="http://localhost:3000"

# ADMIN_PASSWORD: Required for Admin Dashboard authentication
ADMIN_PASSWORD="Admin_CyberWave_ChangeMe_2026!"

# ROUTER_SECRET_KEY: Shared secret or pairing key for OpenWrt router bridge
ROUTER_SECRET_KEY="generate_with_openssl_rand_hex_32"

# UPSTASH_REDIS_REST_URL: Upstash Redis REST endpoint (optional; local disk storage data/ used if omitted)
UPSTASH_REDIS_REST_URL=""

# UPSTASH_REDIS_REST_TOKEN: Upstash Redis REST Token
UPSTASH_REDIS_REST_TOKEN=""

# TELEGRAM_BOT_TOKEN: Optional Telegram Bot token for notifications & interactive commands
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_CHAT_ID: Optional Telegram Admin Chat ID
TELEGRAM_CHAT_ID=""

# TIMEZONE: Dashboard timestamp formatting (e.g. Asia/Kolkata, Asia/Dhaka)
TIMEZONE="Asia/Kolkata"

# PORT: Local server port (Default: 3000)
PORT=3000
