#!/bin/sh /etc/rc.common
# ==============================================================================
# CyberWave Agent Procd Init Service
# /etc/init.d/cyberwave-agent
# ==============================================================================

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/cyberwave-agent.sh
CONF=/etc/cyberwave/agent.conf

start_service() {
    [ -f "$CONF" ] || {
        echo "Configuration file $CONF not found. Run installer first."
        return 1
    }

    [ -x "$PROG" ] || {
        echo "Agent binary $PROG not found or not executable."
        return 1
    }

    procd_open_instance "cyberwave-agent"
    procd_set_param command /bin/sh "$PROG"
    # Auto-respawn if process exits unexpectedly (retry indefinitely every 5s)
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param limits core="0:0"
    procd_close_instance
}

stop_service() {
    killall -q cyberwave-agent.sh 2>/dev/null || true
}

reload_service() {
    stop
    start
}
